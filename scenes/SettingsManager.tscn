[gd_scene format=3 uid="uid://rmyf01pn70ie"]

[sub_resource type="GDScript" id="GDScript_ybbog"]
script/source = "extends Control

# =========================================================
# SettingsManager - Menu de Configurações
# =========================================================
# Estrutura de nós esperada (conforme sua Scene):
# SettingsManager (Control, com este script)
# ├── ColorRect
# ├── VBoxContainer
# │   └── Volume_Geral   (HSlider)
# ├── TelaCheia          (OptionButton, depois de trocar o tipo)
# └── Sair               (Button)
#
# IMPORTANTE: o bus \"Master\" já existe por padrão no Godot,
# então nenhum bus extra precisa ser criado. Todos os sons
# do jogo (música, SFX etc.) sairão por ele, a menos que você
# tenha atribuído seus AudioStreamPlayers a outros buses.
# =========================================================

@onready var slider_geral: HSlider = $VBoxContainer/Volume_Geral
@onready var option_tela: OptionButton = $TelaCheia
@onready var botao_sair: Button = $Sair

const CONFIG_PATH := \"user://settings.cfg\"
const BUS_GERAL := \"Master\"


func _ready() -> void:
	# Configura o slider para trabalhar de 0.0 a 1.0 (volume linear)
	slider_geral.min_value = 0.0
	slider_geral.max_value = 1.0
	slider_geral.step = 0.01

	# Popula as duas opções de tela no OptionButton
	option_tela.clear()
	option_tela.add_item(\"Tela Cheia\", 0)
	option_tela.add_item(\"Janela\", 1)

	# Carrega configurações salvas (ou usa padrão na primeira vez)
	_carregar_configuracoes()

	# Conecta os sinais
	slider_geral.value_changed.connect(_on_volume_geral_changed)
	option_tela.item_selected.connect(_on_tela_selecionada)
	botao_sair.pressed.connect(_on_sair_pressed)


# ---------------------------------------------------------
# Áudio
# ---------------------------------------------------------

func _on_volume_geral_changed(valor: float) -> void:
	_definir_volume_bus(BUS_GERAL, valor)
	_salvar_configuracoes()


func _definir_volume_bus(nome_bus: String, valor_linear: float) -> void:
	var idx := AudioServer.get_bus_index(nome_bus)
	if idx == -1:
		push_warning(\"Bus de áudio '%s' não encontrado.\" % nome_bus)
		return
	# Converte volume linear (0.0 a 1.0) para decibéis
	var db := linear_to_db(clamp(valor_linear, 0.001, 1.0))
	AudioServer.set_bus_mute(idx, valor_linear <= 0.0)
	AudioServer.set_bus_volume_db(idx, db)


# ---------------------------------------------------------
# Tela Cheia / Janela
# ---------------------------------------------------------

func _on_tela_selecionada(indice: int) -> void:
	if indice == 0:
		DisplayServer.window_set_mode(DisplayServer.WINDOW_MODE_FULLSCREEN)
	else:
		DisplayServer.window_set_mode(DisplayServer.WINDOW_MODE_WINDOWED)
	_salvar_configuracoes()


# ---------------------------------------------------------
# Sair
# ---------------------------------------------------------

func _on_sair_pressed() -> void:
	# Se este menu for uma tela separada (não um popup), volte ao menu principal:
	# get_tree().change_scene_to_file(\"res://caminho/para/MenuPrincipal.tscn\")

	# Se for um popup/overlay dentro do jogo, apenas esconda-o:
	# hide()

	# Caso este script controle o encerramento total do jogo, use:
	get_tree().hide()


# ---------------------------------------------------------
# Salvar / Carregar configurações (persistência em disco)
# ---------------------------------------------------------

func _salvar_configuracoes() -> void:
	var config := ConfigFile.new()
	config.set_value(\"audio\", \"geral\", slider_geral.value)
	config.set_value(\"video\", \"tela\", option_tela.selected)
	config.save(CONFIG_PATH)


func _carregar_configuracoes() -> void:
	var config := ConfigFile.new()
	var erro := config.load(CONFIG_PATH)

	if erro != OK:
		# Primeira vez rodando: usa valores padrão
		slider_geral.value = 1.0
		option_tela.selected = 0
	else:
		slider_geral.value = config.get_value(\"audio\", \"geral\", 1.0)
		option_tela.selected = config.get_value(\"video\", \"tela\", 0)

	# Aplica os valores carregados de fato (áudio e janela)
	_definir_volume_bus(BUS_GERAL, slider_geral.value)
	_on_tela_selecionada(option_tela.selected)"

